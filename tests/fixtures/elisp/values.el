;;; -*- lexical-binding: t; -*-
(require 'json)
(require 'cl-lib)
(defun xodb-elisp-values-mark (values)
  (let ((coding-system-for-write 'utf-8-unix) (print-circle t) (print-escape-nonascii nil)
        (print-escape-newlines t) (print-length nil) (print-level nil))
    (with-temp-file (getenv "XODB_ELISP_ORACLE")
      (insert (json-serialize
               (vconcat (mapcar (lambda (entry)
                                  (list :name (car entry) :printed (prin1-to-string (cdr entry))))
                                (append values nil)))))))
  (if (getenv "XODB_ELISP_VALUE_STOPS")
      (mapc (lambda (entry) (xodb-elisp-value-mark (car entry) (cdr entry))) (append values nil))
    (debugger-trap)))
(defun xodb-elisp-value-mark (name value)
  (debugger-trap)
  value)
(let* ((buffer (get-buffer-create "xodb-values"))
       (cycle (list 1 2))
       (self-vector (vector nil))
       (table (make-hash-table :test 'eq))
       (marker (with-current-buffer buffer (insert "hello world") (goto-char 3) (point-marker))))
  (with-current-buffer buffer (setq-local xodb-demo-local 29))
  (set-window-buffer (selected-window) buffer)
  (setcdr (cdr cycle) cycle)
  (aset self-vector 0 self-vector)
  (puthash 'alpha 17 table)
  (puthash 'beta "two" table)
  (xodb-elisp-values-mark
   (vector (cons "fixnum" -17) (cons "float" 1.5) (cons "string" "hello")
           (cons "multibyte" "café λ 😀") (cons "symbol" 'alpha) (cons "nil" nil)
           (cons "list" '(1 "two" alpha)) (cons "dotted" '(1 . 2))
           (cons "vector" [1 "two" alpha]) (cons "record" (record 'demo 1 "two"))
           (cons "hash" table) (cons "buffer" buffer) (cons "marker" marker)
           (cons "window" (selected-window)) (cons "cycle" cycle)
           (cons "self-vector" self-vector) (cons "long-string" (make-string 400 ?x))
           (cons "long-vector" (make-vector 1000 7)) (cons "dead-marker" (make-marker))
           (cons "negative-zero" -0.0) (cons "fraction" 0.1))))
