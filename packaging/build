#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ "$#" -ne 1 ]; then
    echo 'usage: packaging/build DEFAULT_FONT_PATH' >&2
    exit 2
fi
zig version
pkg-config --atleast-version=1.36 wayland-protocols
# Package binaries must run on other CPUs of the same architecture.
exec ./scripts/build app -Doptimize=ReleaseSafe -Dcpu=baseline --build-id=sha1 \
    -Dfont-path="$1" --prefix .work/package
