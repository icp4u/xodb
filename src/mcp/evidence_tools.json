[
  {
    "name": "list_streams",
    "description": "External evidence streams opened with --open-pcap or --open-mitmproxy, plus TLS records derived by --tls-key-log: format, decoder provenance, bounds/loss and declared clock. TLS key material is consumed in memory and is never returned. Read-only; no live capture.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "xodbSessionAccess": "observer"
    }
  },
  {
    "name": "query_stream",
    "description": "Page through a stream's records. Network streams return packet summaries and flow ids; derived TLS streams return authenticated record metadata, plaintext hashes and packet provenance; mitmproxy streams return HTTP request/response metadata and body hashes. include_raw returns packet bytes or private plaintext only to the direct observe-scope connection that opened the stream and is refused under redaction. Continue with start=next.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "stream_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "default": 1,
          "description": "Stream id from list_streams."
        },
        "clock": {
          "type": "string",
          "enum": [
            "stream",
            "capture"
          ],
          "default": "stream"
        },
        "from_ns": {
          "type": "integer",
          "minimum": 0
        },
        "to_ns": {
          "type": "integer",
          "minimum": 0,
          "description": "Exclusive."
        },
        "flow_id": {
          "type": "integer",
          "minimum": 0
        },
        "interface": {
          "type": "integer",
          "minimum": 0
        },
        "protocol": {
          "type": "string",
          "enum": [
            "tcp",
            "udp",
            "icmp",
            "icmpv6"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "undecoded": {
          "type": "boolean"
        },
        "direction": {
          "type": "string",
          "enum": [
            "client_to_server",
            "server_to_client"
          ],
          "description": "TLS streams only."
        },
        "content_type": {
          "type": "string",
          "enum": [
            "change_cipher_spec",
            "alert",
            "handshake",
            "application_data",
            "heartbeat"
          ],
          "description": "TLS inner content type."
        },
        "state": {
          "type": "string",
          "enum": [
            "decrypted",
            "authentication_failed"
          ],
          "description": "TLS authentication state."
        },
        "method": {
          "type": "string",
          "description": "mitmproxy HTTP method filter."
        },
        "status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999,
          "description": "mitmproxy HTTP response status filter."
        },
        "flows": {
          "type": "boolean",
          "default": false,
          "description": "Also return the flow table page (flow_id, 5-tuple, packets, bytes)."
        },
        "include_raw": {
          "type": "boolean",
          "default": false,
          "description": "Network: hex of the first 256 captured bytes. TLS/mitmproxy: up to 65536 plaintext bytes, only for the direct observe-scope opener. Refused (RawPayloadRedacted) under --redact."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Record index to resume scanning from."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "default": 64
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "xodbSessionAccess": "observer"
    }
  },
  {
    "name": "correlate",
    "description": "Join one network packet, or one derived TLS record through its source packet, to the socket and process that held its 5-tuple. basis: exact, sampled, inferred or none. mitmproxy streams have no packet correlation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "stream_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "default": 1,
          "description": "Stream id from list_streams."
        },
        "record": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "record"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "xodbSessionAccess": "observer"
    }
  }
]
