[
  {
    "name": "load_runtime_types",
    "description": "Build a stop-pinned runtime type graph on a bounded worker from complete read-only captures. Jai is the first provider. Own derived cache only; no target code or writes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "jai"
          ]
        },
        "snapshot_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "maxItems": 16
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "process_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      },
      "required": [
        "provider",
        "snapshot_ids",
        "generation"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "xodbSessionAccess": "observer"
    }
  },
  {
    "name": "list_runtime_types",
    "description": "Poll or page a retained runtime type graph. Partial metadata, rejected candidates and stale identity remain explicit.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "process_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "xodbSessionAccess": "observer"
    }
  },
