  {
    "name": "read_runtime_value",
    "description": "Read an explicit typed address at the captured stopped generation. Exact hex bits; bounded rows, raw byte previews, paging and optional pointer traversal. No target execution.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "type_address": {
          "type": "string"
        },
        "type_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "address": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "follow_pointers": {
          "type": "boolean"
        },
        "self_type_field": {
