  {
    "name": "search_runtime_instances",
    "description": "Start an incremental search for a runtime type pointer in an explicit bounded range (address+length), explicit ranges, or a regions selector, exactly as search_memory takes them. Declare the direct self Type field; dynamic_type_address optionally selects a derived record. Reuses the owned memory-search job, get_memory_search per-range coverage and cancel_memory_search. Hits are candidates, never proved live allocations.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "type_address": {
          "type": "string"
        },
        "type_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "self_type_field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "address": {
          "type": "string"
        },
        "process_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "dynamic_type_address": {
          "type": "string"
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              },
              "length": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "address",
              "length"
            ],
            "additionalProperties": false
          }
        },
        "regions": {
          "type": "string",
          "enum": [
            "writable",
            "anon-writable",
            "all-readable"
          ]
        },
        "include_shared": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "generation",
        "self_type_field"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "xodbSessionAccess": "controller"
    }
  },
  {
