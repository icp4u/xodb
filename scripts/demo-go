#!/usr/bin/env bash
# Goroutines, Go stacks and Go values at a native stop. GO selects the go
# toolchain (default /opt/debug/bin/go, else go on PATH).
# Binary order: XODB, ./zig-out/bin/xodb, then xodb on PATH.
set -euo pipefail
umask 022
demo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$demo_root"
go=${GO:-/opt/debug/bin/go}
if [[ -z ${GO:-} && ! -x $go ]]; then go=go; fi
command -v "$go" >/dev/null || { printf '%s\n' 'Set GO to a go toolchain (go1.27.1 is the supported runtime)' >&2; exit 1; }
if [[ -n ${XODB:-} ]]; then
    xodb=$XODB
elif [[ -x zig-out/bin/xodb ]]; then
    xodb=./zig-out/bin/xodb
else
    xodb=$(command -v xodb) || { printf '%s\n' 'Build xodb first with ./scripts/build' >&2; exit 1; }
fi
work=$(mktemp -d "${TMPDIR:-/tmp}/xodb-demo-go.XXXXXX")
trap 'rm -rf -- "$work"' EXIT
(cd examples && "$go" build -o "$work/go-demo" go-demo.go)
cat <<'TIPS'
xodb Go demo: a worker pool (3 goroutines in select), one goroutine blocked on
a sync.Mutex and one sleeping; main stops at main.marker.
  Space        run to main.marker
  Go tab       (click it, or Tab to cycle) lists goroutines with their state;
               select main.blocked for its parked stack (inlined Mutex.Lock)
  F10, C/C++   native locals: strings, slices, structs and Go containers
  E counts Enter, Enter   expand the map entries in a watch
  E err Enter             concrete interface type/value
  E results Enter         channel length, capacity and wait queues
  F10 / F11    step over / step in; Space continues to exit
  Shift+Q      quits
TIPS
"$xodb" "$@" --source examples/go-demo.go --break main.marker -- "$work/go-demo" "$work/truth.txt"
