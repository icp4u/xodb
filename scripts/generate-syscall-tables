#!/usr/bin/env python3
"""Generate the native asm-generic syscall-name rows from Zig's Linux UAPI."""

from pathlib import Path
import argparse
import re
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
TARGETS = {
    "aarch64": "aarch64-linux-gnu",
    "loongarch64": "loongarch64-linux-gnu",
    "riscv64": "riscv64-linux-gnu",
}
SKIP = {"__NR_arch_specific_syscall", "__NR_syscalls"}


def uapi_row(target):
    result = subprocess.run(
        ["zig", "cc", "-target", target, "-E", "-dM", "-x", "c", "-"],
        input="#include <asm/unistd.h>\n",
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    )
    row = {}
    for line in result.stdout.splitlines():
        match = re.fullmatch(r"#define (__NR_[A-Za-z0-9_]+) ([0-9]+)", line)
        if not match:
            continue
        macro, number = match.groups()
        if macro in SKIP or macro.startswith("__NR3264_"):
            continue
        name = macro.removeprefix("__NR_")
        number = int(number)
        if number in row:
            raise SystemExit(f"{target}: duplicate syscall {number}: {row[number]} and {name}")
        row[number] = name
    if len(row) < 300:
        raise SystemExit(f"{target}: incomplete syscall row ({len(row)} entries)")
    return row


def rows():
    found = {name: uapi_row(target) for name, target in TARGETS.items()}
    common = dict(found["loongarch64"])
    for number, name in common.items():
        for arch in ("aarch64", "riscv64"):
            if found[arch].get(number) != name:
                raise SystemExit(
                    f"{arch}: asm-generic row differs at {number}: "
                    f"{found[arch].get(number)!r} != {name!r}"
                )
    extras = {
        arch: {number: name for number, name in row.items() if number not in common}
        for arch, row in found.items()
    }
    if extras["loongarch64"]:
        raise AssertionError(extras["loongarch64"])
    return common, extras


def zig_entries(name, row):
    lines = [f"const {name} = [_]Entry{{"]
    lines += [f'    .{{ .nr = {number}, .name = "{value}" }},' for number, value in sorted(row.items())]
    lines.append("};")
    return "\n".join(lines)


def zig_file(common, extras):
    return f'''//! Generated by scripts/generate-syscall-tables from Zig's Linux UAPI.
//! Do not edit. Native LoongArch64 is the asm-generic baseline; AArch64 and
//! RISC-V add only the entries emitted in their target UAPI headers.

const Entry = struct {{ nr: u32, name: []const u8 }};

{zig_entries("common", common)}

{zig_entries("aarch64_extra", extras["aarch64"])}

{zig_entries("riscv64_extra", extras["riscv64"])}

fn lookup(entries: []const Entry, nr: u32) ?[]const u8 {{
    var lo: usize = 0;
    var hi = entries.len;
    while (lo < hi) {{
        const mid = lo + (hi - lo) / 2;
        if (entries[mid].nr < nr) lo = mid + 1 else hi = mid;
    }}
    return if (lo < entries.len and entries[lo].nr == nr) entries[lo].name else null;
}}

pub const Architecture = enum {{ aarch64, loongarch64, riscv64 }};

pub fn name(arch: Architecture, nr: u32) ?[]const u8 {{
    const extra = switch (arch) {{
        .aarch64 => lookup(&aarch64_extra, nr),
        .loongarch64 => null,
        .riscv64 => lookup(&riscv64_extra, nr),
    }};
    return extra orelse lookup(&common, nr);
}}
'''


def c_file(common, extras):
    lines = [
        "#ifndef XODB_RUNTIME_XRT_GENERIC_SYSCALLS_H",
        "#define XODB_RUNTIME_XRT_GENERIC_SYSCALLS_H",
        "/* Generated by scripts/generate-syscall-tables from Zig's Linux UAPI.",
        " * Do not edit. These are native 64-bit syscall ABI numbers. */",
        "",
    ]
    for number, name in sorted(common.items()):
        lines.append(f"#define XRT_GENERIC_NR_{name} {number}")
    for arch in ("aarch64", "riscv64"):
        if extras[arch]:
            lines.append("")
            for number, name in sorted(extras[arch].items()):
                lines.append(f"#define XRT_{arch.upper()}_NR_{name} {number}")
    lines += ["", "#endif", ""]
    return "\n".join(lines)


def update(path, content, check):
    if check:
        try:
            old = path.read_text()
        except FileNotFoundError:
            old = None
        if old != content:
            print(f"generated syscall table differs: {path.relative_to(ROOT)}", file=sys.stderr)
            return False
        return True
    path.write_text(content)
    return True


def cross_check():
    sources = (
        "src/runtime/perf_syscalls.c",
        "src/runtime/perf_cpu.c",
        "src/runtime/agent_perf.c",
        "src/runtime/fdevent.c",
        "src/runtime/fdevent_count.c",
        "src/runtime/fdflow.c",
    )
    work = ROOT / ".work"
    work.mkdir(mode=0o755, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="syscall-tables-", dir=work) as directory:
        directory = Path(directory)
        perf_regs = directory / "perf_regs.h"
        subprocess.run(
            ["zig", "run", "-OReleaseSafe", "src/profile/perf_regs_gen.zig", "--", str(perf_regs)],
            cwd=ROOT,
            check=True,
        )
        for target in TARGETS.values():
            for source in sources:
                output = directory / f"{target}-{Path(source).stem}.o"
                subprocess.run(
                    [
                        "zig", "cc", "-target", target, "-std=c11", "-Wall", "-Wextra",
                        "-Werror", f"-I{directory}", "-Isrc/runtime", "-c", source, "-o", str(output),
                    ],
                    cwd=ROOT,
                    check=True,
                )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="fail unless checked-in files match the UAPI")
    args = parser.parse_args()
    common, extras = rows()
    ok = update(ROOT / "src/profile/syscalls_generic.zig", zig_file(common, extras), args.check)
    ok &= update(ROOT / "src/runtime/xrt_generic_syscalls.h", c_file(common, extras), args.check)
    if not ok:
        raise SystemExit(1)
    if args.check:
        cross_check()
    print(
        f"syscall tables ok: {len(common)} common, "
        f"{len(extras['aarch64'])} aarch64-only, {len(extras['riscv64'])} riscv64-only"
    )


if __name__ == "__main__":
    main()
