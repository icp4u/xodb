#!/usr/bin/env bash
# Native Perl argument demo. Optional arguments are passed to xodb.
set -euo pipefail
demo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$demo_root"
if [[ ! -x zig-out/bin/xodb ]]; then
    printf '%s\n' 'Build xodb first with ./scripts/build' >&2
    exit 1
fi
perl=/opt/debug/bin/perl
if [[ ! -x "$perl" ]]; then
    printf '%s\n' "Needs a Perl with DWARF at $perl" >&2
    exit 1
fi

# Perl_av_store lives in libperl.so. Assigning a deleted element goes through
# the lexical-array store op, av_fetch(lval) and then av_store(av, 3, sv) on
# every iteration; a plain repeated $a[3]=42 reuses the existing slot instead.
# The handshake ensures the loop is about to run before xodb attaches.
coproc PERL_DEMO {
    exec "$perl" -e '$|=1; my @a=(0)x4; print "$$\n"; while (1) { delete $a[3]; $a[3]=42 }'
}
demo_pid=$PERL_DEMO_PID
cleanup() {
    kill "$demo_pid" 2>/dev/null || :
    wait "$demo_pid" 2>/dev/null || :
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
IFS= read -r -t 10 ready_pid <&"${PERL_DEMO[0]}"
if [[ "$ready_pid" != "$demo_pid" ]]; then
    printf '%s\n' 'Unexpected Perl startup handshake' >&2
    exit 1
fi
set -x
./zig-out/bin/xodb "$@" --attach "$demo_pid" --break Perl_av_store
