#!/usr/bin/env bash
# Native Perl demo: readable Perl values and the Perl stack at native stops.
# Optional arguments are passed to xodb. Binary order: XODB,
# ./zig-out/bin/xodb from this checkout, then xodb on PATH.
set -euo pipefail
demo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$demo_root"
xodb="$(python3 scripts/helpers/demo-binary.py perl)"
perl=/opt/debug/bin/perl
if [[ ! -x "$perl" ]]; then
    printf '%s\n' "Needs a Perl with DWARF at $perl" >&2
    exit 1
fi

# examples/perl-demo.pl re-stores element 3 from nested subs. Deleting first
# forces the store op through av_fetch(lval) and av_store(av, 3, sv) on every
# iteration. The handshake ensures the loop is running before xodb attaches.
coproc PERL_DEMO {
    exec "$perl" examples/perl-demo.pl
}
demo_pid=$PERL_DEMO_PID
cleanup() {
    kill "$demo_pid" 2>/dev/null || :
    wait "$demo_pid" 2>/dev/null || :
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
IFS= read -r -t 10 ready_pid <&"${PERL_DEMO[0]}"
if [[ "$ready_pid" != "$demo_pid" ]]; then
    printf '%s\n' 'Unexpected Perl startup handshake' >&2
    exit 1
fi
cat >&2 <<'TIPS'
Try: Space (stop in Perl_av_store) · Shift+E val Return (a new, undefined element)
     Shift+E av Return (AV, 3 slots) · Space (stop in Perl_av_delete on the next round)
     Live rows update each stop; val is out of scope in delete, then undef at store
     Shift+L converts a selected row to/from a pinned watch; click frames to change context
TIPS
set -x
"$xodb" "$@" --attach "$demo_pid" --break Perl_av_store --break Perl_av_delete
