#!/usr/bin/env python3
"""Generate the typed MCP input decoder; semantic operation mapping stays in commands.zig."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
# This is the migration boundary, not a second field/schema catalog.
TOOLS = ('continue', 'interrupt', 'step_instruction', 'step_over_instruction',
         'step_source', 'step_over', 'set_breakpoint', 'remove_breakpoint',
         'configure_breakpoint', 'finish', 'run_to', 'restart', 'detach')


def require(condition, message):
    # Not assert: python -O must not turn an unsupported schema into a laxer decoder.
    if not condition:
        raise AssertionError('unsupported command schema: ' + message)


def ident(name):
    return '@' + json.dumps(name)


def generate(catalog):
    tools = {t['name']: t for t in catalog}
    lines = ['//! Generated by scripts/gen-command-decode from base_tools.json. Do not edit.',
             'const std = @import("std");', 'const V = std.json.Value;',
             'pub const Request = union(enum) {']
    for name in TOOLS:
        schema = tools[name]['inputSchema']
        require(schema['type'] == 'object' and schema['additionalProperties'] is False, name)
        require(set(schema) <= {'type', 'properties', 'required', 'additionalProperties'}, name)
        require(set(schema['required']) <= set(schema['properties']), name + ' requires an undeclared field')
        require(tools[name]['annotations']['xodbSessionAccess'] == 'controller', name)
        require(not tools[name]['annotations']['readOnlyHint'], name)
        lines += [f'    {ident(name)}: struct {{']
        for key, prop in schema['properties'].items():
            typ = {'integer': 'u64', 'string': '[]const u8', 'boolean': 'bool'}[prop['type']]
            optional = key not in schema['required']
            lines += [f'        {ident(key)}: {"?" if optional else ""}{typ},']
        lines += ['    },']
    lines += ['};', 'pub fn handles(name: []const u8) bool {',
              '    return std.meta.stringToEnum(std.meta.Tag(Request), name) != null;', '}',
              'pub fn decode(name: []const u8, args: V) !Request {',
              '    if (args != .object) return error.InvalidArguments;',
              '    const tag = std.meta.stringToEnum(std.meta.Tag(Request), name) orelse return error.InvalidArguments;',
              '    if (!args.object.contains("generation")) return error.GenerationRequired;',
              '    switch (tag) {']
    for name in TOOLS:
        schema = tools[name]['inputSchema']
        props = schema['properties']
        lines += [f'        .{ident(name)} => {{', '            var fields = args.object.iterator();',
                  '            while (fields.next()) |entry| {',
                  '                inline for (.{ ' + ', '.join(json.dumps(k) for k in props) + ' }) |key| {',
                  '                    if (std.mem.eql(u8, entry.key_ptr.*, key)) break;',
                  '                } else return error.InvalidArguments;', '            }']
        for index, (key, prop) in enumerate(props.items()):
            require(set(prop) <= {'type', 'minimum', 'maximum', 'description', 'maxLength', 'enum'}, f'{name}.{key}')
            require(prop['type'] == 'integer' or not ({'minimum', 'maximum'} & set(prop)), f'{name}.{key} bound on non-integer')
            require(prop['type'] == 'string' or not ({'maxLength', 'enum'} & set(prop)), f'{name}.{key} string constraint on non-string')
            optional = key not in schema['required']
            typ, field = {'integer': ('u64', 'integer'), 'string': ('[]const u8', 'string'), 'boolean': ('bool', 'bool')}[prop['type']]
            lines += [f'            const p{index}: {"?" if optional else ""}{typ} = blk: {{',
                      f'                const v = args.object.get({json.dumps(key)}) orelse ' + ('break :blk null;' if optional else 'return error.InvalidArguments;'),
                      f'                if (v != .{field}) return error.InvalidArguments;']
            if field == 'integer':
                lines += ['                if (v.integer < 0) return error.InvalidArguments;']
                # Historical configure_breakpoint contract: a zero thread is
                # well-formed but unknown, unlike the step tools' invalid tid.
                err = 'UnknownThread' if name == 'configure_breakpoint' and key == 'tid' else 'InvalidArguments'
                for bound, operator in (('minimum', '<'), ('maximum', '>')):
                    if bound in prop:
                        lines += [f'                if (v.integer {operator} {prop[bound]}) return error.{err};']
            if 'maxLength' in prop:
                lines += [f'                if ((std.unicode.utf8CountCodepoints(v.string) catch return error.InvalidArguments) > {prop["maxLength"]}) return error.InvalidArguments;']
            if 'enum' in prop:
                lines += ['                const allowed = ' + ' or '.join(f'std.mem.eql(u8, v.string, {json.dumps(v)})' for v in prop['enum']) + ';',
                          '                if (!allowed) return error.InvalidArguments;']
            lines += [f'                break :blk {"@intCast(v.integer)" if field == "integer" else "v." + field};', '            };']
        lines += [f'            return .{{ .{ident(name)} = .{{']
        lines += [f'                .{ident(key)} = p{i},' for i, key in enumerate(props)]
        lines += ['            } };', '        },']
    lines += ['    }', '}', '']
    return '\n'.join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true')
    args = parser.parse_args()
    output = ROOT / 'src/model/command_decode.zig'
    generated = generate(json.loads((ROOT / 'src/mcp/base_tools.json').read_text()))
    if args.check:
        if not output.exists() or output.read_text() != generated:
            sys.exit('command decoder is stale: run python3 scripts/gen-command-decode')
    else:
        output.write_text(generated)


if __name__ == '__main__':
    main()
