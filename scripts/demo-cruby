#!/usr/bin/env bash
# Stopped CRuby frames and values. RUBY selects the supported debug runtime.
# Binary order: XODB, ./zig-out/bin/xodb, then xodb on PATH.
set -euo pipefail
demo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$demo_root"
ruby=${RUBY:-/opt/debug/bin/ruby}
if [[ -n ${XODB:-} ]]; then
    xodb=$XODB
elif [[ -x zig-out/bin/xodb ]]; then
    xodb=./zig-out/bin/xodb
else
    xodb=$(command -v xodb) || { printf '%s\n' 'Build xodb first with ./scripts/build' >&2; exit 1; }
fi
command -v "$ruby" >/dev/null
# Attach only once the example has finished interpreter startup. Otherwise a
# launch-time rb_ary_store breakpoint stops inside CRuby initialization first.
coproc CRUBY_DEMO {
    exec "$ruby" examples/ruby-demo.rb
}
demo_pid=$CRUBY_DEMO_PID
cleanup() {
    kill "$demo_pid" 2>/dev/null || :
    wait "$demo_pid" 2>/dev/null || :
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
IFS= read -r -t 10 ready_pid <&"${CRUBY_DEMO[0]}"
if [[ "$ready_pid" != "$demo_pid" ]]; then
    printf '%s\n' 'Unexpected Ruby startup handshake' >&2
    exit 1
fi
"$xodb" "$@" --source examples/ruby-demo.rb --attach "$demo_pid" --break rb_ary_store
