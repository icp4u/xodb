#!/usr/bin/env bash
# Native CRuby argument demo. Optional arguments are passed to xodb.
set -euo pipefail
demo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$demo_root"
if [[ ! -x zig-out/bin/xodb ]]; then
    printf '%s\n' 'Build xodb first with ./scripts/build' >&2
    exit 1
fi
command -v ruby >/dev/null

# The handshake ensures libruby is loaded before --break resolves its symbol.
coproc CRUBY_DEMO {
    exec /opt/debug/bin/ruby -e 'a=[]; $stdout.sync=true; puts Process.pid; loop { a[3]=42 }'
}
demo_pid=$CRUBY_DEMO_PID
cleanup() {
    kill "$demo_pid" 2>/dev/null || :
    wait "$demo_pid" 2>/dev/null || :
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
IFS= read -r -t 10 ready_pid <&"${CRUBY_DEMO[0]}"
if [[ "$ready_pid" != "$demo_pid" ]]; then
    printf '%s\n' 'Unexpected Ruby startup handshake' >&2
    exit 1
fi
set -x
./zig-out/bin/xodb "$@" --attach "$demo_pid" --break rb_ary_store
