#!/bin/sh
# Owned glibc workload: five successful allocations, one failed realloc,
# one retained 29-byte block. No sudo unless --allocation-helper is supplied.
# Binary order: XODB, ./zig-out/bin/xodb, then xodb on PATH.
set -eu
cd "$(dirname "$0")/.."
if [ -n "${XODB:-}" ]; then
  xodb=$XODB
elif [ -x zig-out/bin/xodb ]; then
  xodb=./zig-out/bin/xodb
else
  xodb=$(command -v xodb) || { echo 'Build xodb first with ./scripts/build' >&2; exit 1; }
fi
mkdir -p .work/tmp
demo_dir=$(mktemp -d "$PWD/.work/demo-allocations.XXXXXXXX")
TMPDIR="$PWD/.work/tmp" cc -pthread -g -O0 -fno-builtin -fno-omit-frame-pointer \
  -Wall -Wextra -Werror tests/fixtures/allocations.c -o "$demo_dir/fixture"
cat >&2 <<'HELP'
Allocation demo:
  Space: run to allocation_marker phase=0 (past the loader).
  A: allocation inspector. P: start on the selected stopped thread.
  Wait for "Tracing selected threads", then Space to run to allocation_marker phase=1.
  P: stop capture. L: lifetimes. O: outstanding (one 29-byte block).
  Esc: return to source. Q: close and clean up the owned child.
If perf is denied, see docs/ALLOCATIONS.md for the explicit helper option.
HELP
exec "$xodb" "$@" --break allocation_marker -- "$demo_dir/fixture" demo
