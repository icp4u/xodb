def group_members(group):
    members = []
    for entry in Path('/proc').iterdir():
        if not entry.name.isdecimal():
            continue
        try:
            fields = (entry / 'stat').read_text().rsplit(') ', 1)[1].split()
            if int(fields[2]) == group:
                members.append(int(entry.name))
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            pass
    return members


def stop_group(group):
    # Each step starts a new session. Only that step and its descendants share
    # this process group; never signal by executable name or a global PID search.
    for sig, seconds in ((signal.SIGTERM, 1), (signal.SIGKILL, 2)):
        try:
            os.killpg(group, sig)
        except ProcessLookupError:
            break
        until = time.monotonic() + seconds
        while time.monotonic() < until:
            # The runner is a subreaper: reap orphaned fixtures/compositors too.
            try:
                while os.waitpid(-group, os.WNOHANG)[0] > 0:
                    pass
            except ChildProcessError:
                pass
            if not group_members(group):
                return []
            time.sleep(.02)
    return group_members(group)


def children():
    # Every thread's children: a step started by a worker thread is listed
    # under that thread, an adopted orphan under any live one.
    found = set()
    for task in Path('/proc/self/task').iterdir():
        try:
            found.update(map(int, (task / 'children').read_text().split()))
        except (FileNotFoundError, ProcessLookupError):
            pass
    return found


def session_of(pid):
    try:
        return int(Path(f'/proc/{pid}/stat').read_text().rsplit(') ', 1)[1].split()[3])
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        return None


def adopted_since(baseline, session=None):
    # While other steps run, only children still in this step's session are
    # certainly its own. run_steps checks the rest once nothing is running.
    found = children() - baseline
    return found if session is None else {pid for pid in found if session_of(pid) == session}


def stop_adopted(baseline, session=None):
    # GDB/inferiors may change process groups. As a subreaper, the runner owns
    # those orphaned children too. Preserve any children predating this step.
    for sig, seconds in ((signal.SIGTERM, 1), (signal.SIGKILL, 2)):
        until = time.monotonic() + seconds
        while time.monotonic() < until:
            adopted = adopted_since(baseline, session)
            if not adopted:
                return []
            for pid in adopted:
                try:
                    # A live unreaped child cannot have its PID reused between
                    # this check and kill; nothing else waits for these PIDs.
                    if os.waitpid(pid, os.WNOHANG)[0] == 0:
                        os.kill(pid, sig)
                except (ChildProcessError, ProcessLookupError):
                    pass
            time.sleep(.02)
    return sorted(adopted_since(baseline, session))


def _shell_quote(text):
    return "'" + str(text).replace("'", "'\\''") + "'"


def arm_agent_start_check(name, argv, cwd, logs):
    """Point a lane step's switch at a wrapper that records one agent start.

    The wrapper writes a marker and then executes the real agent. A lane step
    that exits 0 without that marker did not start the agent.
    """
    argv = list(argv)
    if not str(name).endswith(AGENT_LANE_SUFFIX):
        return argv, None
    prefix = 'XODB_TEST_RUNTIME_AGENT='
    marker = Path(logs) / (str(name) + '.agent-started')
    index = next((i for i, arg in enumerate(argv) if isinstance(arg, str) and arg.startswith(prefix)), None)
    if index is None:
        return argv, marker
    real = argv[index][len(prefix):]
    if not os.path.isabs(real):
        real = str(Path(cwd) / real)
    wrapper = Path(logs) / (str(name) + '.agent-wrapper')
    wrapper.write_text('#!/bin/sh\nset -eu\n: > %s\nexec %s "$@"\n' % (_shell_quote(marker), _shell_quote(real)))
    wrapper.chmod(0o755)
    argv[index] = prefix + str(wrapper)
    return argv, marker


def child_environment(inherited):
    # A gate has no interactive terminal. Individual tests opt into the colour,
    # geometry or locale they exercise, after this per-step baseline is applied.
    removed = {'NO_COLOR', 'COLORTERM', 'CLICOLOR', 'CLICOLOR_FORCE', 'FORCE_COLOR',
               'TERM', 'TERMINFO', 'TERMINFO_DIRS', 'TERMCAP', 'TERM_PROGRAM',
               'TERM_PROGRAM_VERSION', 'COLORFGBG', 'COLUMNS', 'LINES',
               'LANG', 'LANGUAGE', 'TZ'}
    env = {key: value for key, value in inherited.items()
           if key not in removed and not key.startswith('LC_')}
    env.update(TERM='dumb', LANG='C.UTF-8', LC_ALL='C.UTF-8', TZ='UTC')
    return env


def run_step(name, argv, timeout, cwd, env, logs, halt=None):
    # halt is set for a step that runs beside others: an Event that interrupts it.
    log = logs / (name + '.log')
    started = time.monotonic()
    outcome = dict(name=name, argv=list(argv), timeout_seconds=timeout, log=str(log), status='failed')
    child = None
    marker = None
    baseline = children()
    with log.open('x') as stream:
        try:
            argv, marker = arm_agent_start_check(name, argv, cwd, logs)
            child = subprocess.Popen(argv, cwd=cwd, env=child_environment(env), stdout=stream,
                                     stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
            try:
                while True:
                    left = started + timeout - time.monotonic()
                    try:
                        outcome['exit_code'] = child.wait(timeout=min(left, .1) if halt else timeout)
                        outcome['status'] = 'passed' if child.returncode == 0 else 'failed'
                    except subprocess.TimeoutExpired:
                        if halt and halt.is_set():
                            outcome['status'] = 'interrupted'
                        elif halt and left > .1:
                            continue
                        else:
                            outcome['status'] = 'timeout'
                    break
            except KeyboardInterrupt:
                outcome['status'] = 'interrupted'
        except OSError as exc:
            outcome['error'] = str(exc)
        finally:
            if child:
                members = group_members(child.pid)
                if members:
                    outcome['leftover_pids'] = members
                    outcome['remaining_pids'] = stop_group(child.pid)
                    if outcome['status'] == 'passed':
                        outcome['status'] = 'leaked_processes'
                try:
                    child.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    outcome['status'] = 'cleanup_failed'
                    outcome['remaining_pids'] = group_members(child.pid)
    session = (child.pid if child else 0) if halt else None
    adopted = adopted_since(baseline, session)
    if adopted:
        outcome['adopted_pids'] = sorted(adopted)
        remaining = stop_adopted(baseline, session)
        outcome['remaining_pids'] = sorted(set(outcome.get('remaining_pids', [])) | set(remaining))
        if outcome['status'] == 'passed':
            outcome['status'] = 'leaked_processes'
        if remaining:
            outcome['status'] = 'cleanup_failed'
    if marker is not None:
        started_agent = marker.is_file()
        outcome['agent_started'] = started_agent
        if not started_agent and outcome['status'] == 'passed':
            outcome['status'] = 'agent_not_started'
    outcome['seconds'] = round(time.monotonic() - started, 3)
    print(f"{outcome['status']:16} {name} ({outcome['seconds']:.1f}s)", flush=True)
    return outcome


def work_entries(tree):
    try:
        return set(os.listdir(Path(tree) / '.work'))
    except FileNotFoundError:
        return set()


def set_aside(tree, before, attempt, only=None):
    """Rename what a failed attempt created directly in .work to NAME.attemptN.

    Tests create their work directories with a plain mkdir, under names fixed
    by their argv or by the test itself. A retry with the same argv would stop
    at that mkdir. Renaming keeps the failed attempt's files as evidence.
    Beside other steps, only the step's declared entries (only) are its own.
    """
    moved = []
    for entry in sorted(work_entries(tree) - before):
        if only is not None and entry not in only:
            continue
        target = f'{entry}.attempt{attempt}'
        try:
            os.rename(Path(tree) / '.work' / entry, Path(tree) / '.work' / target)
        except OSError:
            continue
        before.add(target)
        moved.append(entry)
    return moved


# A failed prerequisite makes every later step meaningless, even with --keep-going.
PREREQUISITES = ('probe-build', 'capabilities', 'headless-app', 'build-tests')


def run_steps(steps, tree, env, logs, report, keep_going=False, retries=0, jobs=1):
    steps = [step if isinstance(step, Step) else Step(*step) for step in steps]
    order = {step.name: index for index, step in enumerate(steps)}
    halt, finished = threading.Event(), queue.Queue()

    def attempts(step, beside):
        before = work_entries(tree)
        result = run_step(step.name, step.argv, step.timeout, tree, env, logs, halt if beside else None)
        earlier = []
        # GUI steps may get recorded retries. A pass after a failure is
        # reported as flaky, never as passed.
        while result['status'] in ('failed', 'timeout') and len(earlier) < retries and step.kind == 'gui' and step.name not in NO_RETRY:
            earlier.append(result)
            result['set_aside'] = set_aside(tree, before, len(earlier), step.work if beside else None)
            result = run_step(f'{step.name}.retry{len(earlier)}', step.argv, step.timeout, tree, env, logs, halt if beside else None)
            result['name'] = step.name
        if earlier:
            result['earlier_attempts'] = earlier
            if result['status'] == 'passed':
                result['status'] = 'flaky'
                print(f"{'flaky':16} {step.name} (passed on retry {len(earlier)})", flush=True)
        if beside:
            result['beside'] = True
        return result

    def worker(step):
        try:
            result = attempts(step, True)
        except Exception as exc:
            result = dict(name=step.name, argv=step.argv, status='failed', error=repr(exc), log=str(logs / (step.name + '.log')))
        finished.put(result)

    failures, good, bad, skipped = [], set(), set(), []
    pending, running, batch = list(steps), set(), []
    start, stop, blocked = children(), False, False
    try:
        while True:
            for step in [] if stop else list(pending):
                if any(need in bad for need in step.needs):
                    bad.add(step.name)  # stays "not run": its prerequisite did not pass
                    skipped.append(dict(name=step.name, needs=[need for need in step.needs if need in bad]))
                    pending.remove(step)
                elif any(need in order and need not in good for need in step.needs):
                    continue
                elif jobs > 1 and step.kind == 'gui' and not step.serial:
                    if len(running) < jobs:
                        pending.remove(step)
                        running.add(step.name)
                        batch.append(step.name)
                        threading.Thread(target=worker, args=(step,), daemon=True).start()
                elif not running:
                    pending.remove(step)
                    finished.put(attempts(step, False))
                    break
            if finished.empty() and not running:
                break
            result = finished.get()
            running.discard(result['name'])
            report['steps'].append(result)
            if result['name'] == 'capabilities' and result.get('exit_code') == 2 and not result.get('leftover_pids'):
                blocked = True
                break
            if result['status'] in ('passed', 'flaky'):
                good.add(result['name'])
            else:
                bad.add(result['name'])
                failures.append(result)
                if not keep_going or result['name'] in PREREQUISITES or result['status'] == 'interrupted':
                    stop = True
            if batch and not running:
                # Children that left their step's session could not be
                # attributed while other steps ran. None may outlive the batch.
                strays = sorted(children() - start)
                if strays:
                    left = stop_adopted(start)
                    failures.append(dict(name='parallel-strays', status='cleanup_failed' if left else 'leaked_processes',
                                         adopted_pids=strays, remaining_pids=left, among=batch, log=str(logs)))
                    report['steps'].append(failures[-1])
                    stop = stop or not keep_going
                batch = []
    except KeyboardInterrupt:
        halt.set()
        while running:
            try:
                result = finished.get()
            except KeyboardInterrupt:  # a second interrupt must not abandon the steps being stopped
                continue
            running.discard(result['name'])
            report['steps'].append(result)
            failures.append(result)
        failures.append(dict(name='runner', status='interrupted', log=str(logs)))
    if blocked:
        report.update(status='blocked', reason='Owned ptrace/perf probe denied; see capabilities.log and SETUP.md')
        return 2
    done = report['steps']
    done.sort(key=lambda step: order.get(step['name'], len(order)))
    ran = {step['name'] for step in done}
    report['skipped'] = skipped
    report['not_run'] = [step.name for step in steps if step.name not in ran]
    if report['not_run'] and not failures:
        # Nothing failed, yet planned steps never started (needs that cannot be met). Never a pass.
        failures.append(dict(name='runner', status='unscheduled', log=str(logs)))
    flaky = [step['name'] for step in done if step['status'] == 'flaky']
    report['flaky'] = flaky
    report['failures'] = [dict(name=step['name'], status=step['status'], log=step['log']) for step in failures]
    report['summary'] = dict(planned=len(steps), passed=sum(step['status'] == 'passed' for step in done),
                             flaky=len(flaky), failed=len(failures), not_run=len(report['not_run']))
    if failures:
        report.update(status='failed', reason=', '.join(step['name'] + ': ' + step['status'] for step in failures))
        return 1
    return 0


def select(steps, only=None, start=None):
    # Each run builds a fresh snapshot, so keep what the chosen steps need.
    by = {step.name: step for step in steps}
    names = list(by)
    unknown = [name for name in [*(only or ()), *([start] if start else [])] if name not in by]
    if unknown:
        raise ValueError('unknown step: ' + ', '.join(unknown))
    wanted = names[names.index(start):] if start else list(only or names)
    for name in wanted:
        wanted += [need for need in by[name].needs if need in by and need not in wanted]
    return [step for step in steps if step.name in wanted]


def hubs():
    """The files with a fan-in budget in tools/deps/budgets: importer walks stop at them."""
    names = set()
    for line in (ROOT / 'tools/deps/budgets').read_text().splitlines():
        line = line.split('#', 1)[0].split()
        if line:
            names.add(line[0])
    return names


def importers_from_deps():
    """{file: files that import it directly} from scripts/deps; None when it cannot say."""
    out = subprocess.run([sys.executable, '-I', str(ROOT / 'scripts/deps'), 'graph', '--json'], cwd=ROOT, capture_output=True, text=True)
    if out.returncode:
        return None
    rev = {}
    for edge in json.loads(out.stdout)['edges']:
        rev.setdefault(edge['target'], set()).add(edge['source'])
    return rev


def covering_importers(path, importers, covered, stop):
    """The nearest covered files that import path, walking up the import graph
    and stopping at each covered file and at each hub (tools/deps/budgets).
    escaped says some upward path ended at an uncovered file nothing imports,
    or at a hub: then the covered importers do not stand for every use of path."""
    nearest, seen, todo, escaped = set(), {path}, [path], False
    while todo:
        sources = importers.get(todo.pop(), ())
        for source in sources:
            if source in seen:
                continue
            seen.add(source)
            if source in stop:
                escaped = True
                if covered(source):
                    nearest.add(source)
            elif covered(source):
                nearest.add(source)
            elif not importers.get(source):
                escaped = True
            else:
                todo.append(source)
    return nearest, escaped


def affected(steps, changed, fallback, registered=(), importers=None):
    """The steps that cover the changed files, and a line per decision.

    A file that no planned step covers selects every step named in fallback.
    An uncovered file under tests/ or scripts/ selects every planned step
    outside PERIODIC: a helper may be loaded by any step of either lane. registered names the
    steps whose registration changed, for scripts/release-check itself.
    importers (from importers_from_deps) adds, for a source file, the steps
    that cover the files importing it; an uncovered source file whose importers
    are covered selects those steps instead of the fallback, unless the walk
    reached a hub file (tools/deps/budgets), where it keeps the fallback.
    """
    wanted, lines = {'release-runner'}, []
    hub_files = hubs() if importers else set()
    cover = {}

    def covering(source):
        if source not in cover:
            cover[source] = [step.name for step in steps if step.name not in ALWAYS and any(fnmatch.fnmatchcase(source, glob) for glob in step.paths)]
        return cover[source]
    for path in changed:
        names = [step.name for step in steps if any(fnmatch.fnmatchcase(path, glob) for glob in step.paths)]
        direct = any(name not in ALWAYS for name in names)
        if importers and path.startswith('src/') and path not in hub_files:
            nearest, escaped = covering_importers(path, importers, covering, hub_files)
            via = {}
            for source in sorted(nearest):
                for name in covering(source):
                    via.setdefault(name, source)
            extra = [name for name in via if name not in names]
            if direct and extra:
                names = names + extra
                lines.append(f'affected: {path}: {len(names)} steps ({len(extra)} via nearest covered importers): ' + ' '.join(names))
                wanted.update(names)
                continue
            if not direct and via and not escaped:
                lines.append(f'affected: {path}: not mapped; every importer path reaches covered files, so their {len(extra)} steps: '
                             + ' '.join(f'{name} ({via[name]})' for name in extra))
                wanted.update(names + extra)  # keep the ALWAYS steps (deps) that map every source
                continue
        if path == 'scripts/release-check' and registered:
            names = [step.name for step in steps if step.name in registered or step.name in names]
            lines.append(f'affected: {path}: {len(names)} steps, those whose registration changed: ' + ' '.join(names))
        elif path == 'scripts/release-check':
            names = fallback
            lines.append(f'affected: {path}: no registration changed, so the full gui tier ({len(names)} steps)')
        elif any(name not in ALWAYS for name in names):
            lines.append(f'affected: {path}: {len(names)} steps: ' + ' '.join(names))
        elif path.startswith(('tests/', 'scripts/')):
            names = [step.name for step in steps if not periodic(step.name)]
            lines.append(f'affected: {path}: not mapped, so every planned step ({len(names)} steps)')
        else:
            names = fallback
            lines.append(f'affected: {path}: not mapped, so the full gui tier ({len(names)} steps)')
        wanted.update(names)
    return select(steps, [step.name for step in steps if step.name in wanted]), lines


def registered_since(base, runtimes, redot=None):
    """Names of the steps that base's scripts/release-check plans differently
    or not at all. Empty when that plan cannot be made."""
    old = subprocess.run(['git', 'show', base + ':scripts/release-check'], cwd=ROOT, capture_output=True, text=True)
    scope = {'__name__': 'base', '__file__': __file__}
    try:
        exec(compile(old.stdout, 'base', 'exec'), scope)
        before = {step[0]: list(step) for step in scope['plan']('all', *runtimes)}
    except Exception:
        return []
    return [step.name for step in plan('all', *runtimes, redot=redot) if before.get(step.name) != list(step)]


def snapshot(destination):
    # Copy tracked *working* contents, including local edits, but no ignored
    # caches, captures or untracked prototypes that could hide missing inputs.
    names = subprocess.check_output(['git', 'ls-files', '-z', '--', 'build.zig', 'build_macos.zig',
        'build.zig.zon', 'src', 'tests', 'scripts', 'tools', 'examples', 'packaging',
        'docs', 'config', 'README.md', 'LICENSE', 'SETUP.md'], cwd=ROOT).decode().split('\0')
    hashes = {}
    for name in filter(None, names):
        source = ROOT / name
        if source.is_symlink():
            raise RuntimeError(f'Test snapshot requires regular source files: {name}')
        if not source.is_file():
            raise RuntimeError(f'Tracked source missing: {name}')
        target = destination / name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
        hashes[name] = hashlib.sha256(target.read_bytes()).hexdigest()
    return hashes


def performance_summary(tree):
    report = {}
    statuses = []
    for key, path, nested in (
        ('measurements', '.work/perf-observers/results.json', None),
        ('remote_stop_measurements', '.work/perf-remote-stops/results.json', 'performance'),
        ('syscall_measurements', '.work/perf-syscalls/results.json', None),
    ):
        value = json.loads((tree / path).read_text())
        status = (value[nested] if nested else value)['status']
        if status not in ('measured', 'not-measurable'):
            raise ValueError(key + ': measurements did not complete')
        report[key] = value
        statuses.append(status)
    report['status'] = 'not-measurable' if 'not-measurable' in statuses else 'passed'
    return report


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('tier', choices=['portable', 'host', 'gui', 'all', 'periodic', 'periodic-gui', 'perf', 'affected'],
                        help='affected: the host and gui steps that cover the files changed against --base; '
                             'periodic, periodic-gui: the full matrices and the slow host/gui steps that all leaves out')
    parser.add_argument('--headless', action='store_true', help='Portable CI without GUI build dependencies')
    parser.add_argument('--optimize', choices=['Debug', 'ReleaseSafe'], default='ReleaseSafe')
    parser.add_argument('--list', action='store_true', help='Print planned commands without running or writing files')
    parser.add_argument('--records', action='store_true', help='With --list, print whole step records (schema 2: kind, needs, paths, serial, work)')
    parser.add_argument('--base', metavar='REV', help='affected: compare the index and working tree with this revision (default HEAD)')
    parser.add_argument('--jobs', type=int, default=1, metavar='N', help='Run up to N GUI steps at once, each on its own private compositor; steps marked serial still run alone (default 1)')
    parser.add_argument('--slowest', type=int, default=0, metavar='N', help='Also print the N slowest steps')
    parser.add_argument('--uprobes', action='store_true', help='Also test function capture; explicitly permits the built helper to use sudo -n for owned fixtures')
    parser.add_argument('--perl', help='Include the Perl live-display GUI scenario using this debug Perl 5.44 executable')
    parser.add_argument('--padwalker', help='Built test-only PadWalker tree for Perl named-local oracle checks; requires --perl')
    parser.add_argument('--python', help='Include language-tab and cached-selection checks using this debug CPython runtime')
    parser.add_argument('--emacs', help='Include GNU Emacs 31.1 stack checks using its same-image DWARF')
    parser.add_argument('--ruby', help='Include the exact supported CRuby DWARF runtime and its matching development headers')
    parser.add_argument('--node', help='Include Node.js language checks using this explicitly selected runtime')
    parser.add_argument('--wine', help='Include owned stripped PE/Jai checks with this Wine executable (periodic tiers; private prefix)')
    parser.add_argument('--go', help='Include Go goroutine checks using this go toolchain (builds an owned fixture)')
    parser.add_argument('--redot', help='Include GDScript stack and value checks using this debug-enabled Redot or Godot 4 engine binary with DWARF')
    parser.add_argument('--macos-ssh', metavar='HOST', help='Include the live Apple debugserver test against this Mac, reached with ssh HOST (periodic tier; no default host)')
    parser.add_argument('--macos', metavar='HOST', help='Opt-in native macOS build, Cocoa contract, bundle and offscreen presentation checks over SSH (gui/all/periodic; no on-screen windows)')
    parser.add_argument('--arm64-sidecar', nargs=3, metavar=('SSH', 'AGENT', 'FIXTURE'), help='Include the live arm64 Ghidra-sidecar test using an SSH destination and owned remote agent/fixture paths (periodic tier)')
    parser.add_argument('--riscv64-guest', nargs=3, metavar=('SSH', 'AGENT', 'FIXTURE'), help='Include the riscv64 software-step driver (periodic tier). AGENT and FIXTURE are remote executables; a path that is not executable makes the step build a fresh guest tree. Holds XODB_GUEST_LEASE and uses ssh from PATH.')
    parser.add_argument('--node-refusal', help='Also require completed metadata and an exact frame-proof refusal from this separately selected Node build (gui/all)')
    parser.add_argument('--lua', action='append', nargs=3, default=[], metavar=('EXECUTABLE', 'SOURCE', 'LIBRARY'), help='Include Lua live/component checks; repeat for each debug runtime and matching internal headers/static library')
    parser.add_argument('--node-include', default='/usr/include/node', help='Matching Node development header directory')
    parser.add_argument('--capstone', choices=['system', 'vendored'], default='system', help='Link system Capstone, or the private prefix from scripts/build-capstone')
    parser.add_argument('--agent-lane', action='store_true', help='Run every eligible target step through the local C agent (zig-out/bin/xodb-agent). Steps that cannot use it are omitted and listed with a reason. The periodic tier adds these variants beside its own steps.')
    parser.add_argument('--keep-going', action='store_true', help='Run every step after a failure (not after a failed build or probe), then summarise all failures')
    parser.add_argument('--compare-binary', metavar='XODB', help='Opt-in: compare the same MCP command transcript against this reference binary (host/all/affected/periodic)')
    parser.add_argument('--compare-agent', metavar='AGENT', help='Also compare local-agent mode using this reference agent and the built candidate agent; requires --compare-binary')
    parser.add_argument('--retry-flaky', type=int, metavar='N', help='Retry a failed GUI step up to N times; a later pass is recorded as flaky (default 1 for gui, all and periodic-gui, else 0)')
    chosen = parser.add_mutually_exclusive_group()
    chosen.add_argument('--only', metavar='STEP[,STEP]', help='Run only these steps (plus build-tests and their build steps)')
    chosen.add_argument('--from', dest='start', metavar='STEP', help='Run this step and every later step (plus build-tests)')
    args = parser.parse_args(argv)
    tier = args.tier
    if args.compare_agent and not args.compare_binary:
        parser.error('--compare-agent requires --compare-binary')
    if args.compare_binary and (tier not in ('host', 'all', 'affected', 'periodic') or args.headless):
        parser.error('--compare-binary requires host, all, affected or periodic, without --headless')
    if args.base and tier != 'affected':
        parser.error('--base requires the affected tier')
    if args.records and not args.list:
        parser.error('--records requires --list')
    if args.jobs < 1 or args.slowest < 0:
        parser.error('--jobs must be 1 or more, and --slowest 0 or more')
    if tier == 'affected':
        args.tier = 'all'  # plan both lanes, then keep the steps that cover the change
    retries = args.retry_flaky if args.retry_flaky is not None else 1 if args.tier in ('gui', 'all', 'periodic-gui') else 0
    if retries < 0:
        parser.error('--retry-flaky must be 0 or more')
    if args.wine and args.tier not in ('periodic', 'periodic-gui'):
        parser.error('--wine requires periodic or periodic-gui')
    if args.headless and args.tier not in ('portable', 'periodic', 'perf'):
        parser.error('--headless is for the portable, periodic or perf tier; release host/GUI coverage builds the GUI')
    if args.uprobes and args.tier not in ('host', 'all'):
        parser.error('--uprobes requires the host or all tier')
    if args.perl and args.tier in ('portable', 'perf'):
        parser.error('--perl is not for the portable or perf tier')
    if args.padwalker and not args.perl:
        parser.error('--padwalker requires --perl')
    if args.python and args.tier in ('portable', 'perf'):
        parser.error('--python is not for the portable or perf tier')
    if args.emacs and args.tier in ('portable', 'perf'):
        parser.error('--emacs is not for the portable or perf tier')
    if args.ruby and args.tier in ('portable', 'perf'):
        parser.error('--ruby is not for the portable or perf tier')
    if args.go and args.tier in ('portable', 'perf'):
        parser.error('--go is not for the portable or perf tier')
    if args.redot and args.tier in ('portable', 'perf'):
        parser.error('--redot is not for the portable or perf tier')
    if args.macos_ssh and (args.tier != 'periodic' or args.headless):
        parser.error('--macos-ssh requires the periodic tier without --headless')
    if args.macos and (args.tier not in ('gui', 'all', 'periodic') or args.headless):
        parser.error('--macos requires gui/all/periodic without --headless')
    if args.arm64_sidecar and args.tier != 'periodic':
        parser.error('--arm64-sidecar requires the periodic tier')
    if args.riscv64_guest and args.tier != 'periodic':
        parser.error('--riscv64-guest requires the periodic tier')
    if args.node and args.tier in ('portable', 'perf'):
        parser.error('--node is not for the portable or perf tier')
    if args.node_refusal and args.tier not in ('gui', 'all', 'periodic', 'periodic-gui'):
        parser.error('--node-refusal requires the gui or all tier, or a periodic tier')
    if args.lua and args.tier in ('portable', 'perf'):
        parser.error('--lua is not for the portable or perf tier')
    if args.agent_lane and args.tier == 'affected':
        parser.error('--agent-lane selects a tier; affected adds the variants when a runtime or agent file changes')
    runtimes = (args.headless, args.optimize, args.uprobes, args.perl, args.node, args.node_include, args.lua, args.python, args.padwalker, args.ruby, args.node_refusal, args.go, args.wine, args.emacs)
    steps = plan(args.tier, *runtimes, redot=args.redot, macos_ssh=args.macos_ssh, arm64_sidecar=args.arm64_sidecar, macos=args.macos, riscv64_guest=args.riscv64_guest)
    decisions, missing = [], []
    if tier == 'affected':
        base = args.base or 'HEAD'
        diff = subprocess.run(['git', 'diff', '--name-only', '-z', base, '--'], cwd=ROOT, capture_output=True, text=True)
        changed = sorted(filter(None, diff.stdout.split('\0')))
        if diff.returncode:
            parser.error('git diff failed: ' + diff.stderr.strip())
        if not changed:
            parser.error(f'no tracked file differs from {base}; nothing is affected (pass --base REV, or run a tier)')
        registered = registered_since(base, runtimes, args.redot) if 'scripts/release-check' in changed else ()
        steps += plan('all', *runtimes, moved=True, redot=args.redot)  # selected only by their own test scripts
        everything = steps
        importers = importers_from_deps()
        steps, decisions = affected(steps, changed, [step.name for step in plan('gui', *runtimes, redot=args.redot)], registered, importers)
        if importers is None:
            decisions.append('affected: WARNING: scripts/deps graph failed; mapping by COVERS only')
        # A runtime that was not passed has no steps to select. Say what the change lost.
        chosen = {step.name for step in steps}
        for flag, more in (('perl', dict(perl='PERL')), ('padwalker', dict(perl=args.perl or 'PERL', padwalker='PADWALKER')), ('python', dict(python='PYTHON')),
                           ('emacs', dict(emacs='EMACS')), ('ruby', dict(ruby='RUBY')), ('node', dict(node='NODE')), ('go', dict(go='GO')), ('redot', dict(redot='REDOT')),
                           ('lua', dict(lua=[('LUA', 'SOURCE', 'LIBRARY')]))):
            if getattr(args, flag):
                continue
            named = dict(zip(('headless', 'optimize', 'uprobes', 'perl', 'node', 'node_include', 'lua', 'python', 'padwalker', 'ruby', 'node_refusal', 'go', 'wine', 'emacs'), runtimes), **dict(dict(redot=args.redot), **more))
            lost = [step.name for step in affected(plan('all', **named), changed, [step.name for step in plan('gui', **named)], registered, importers)[0] if step.name not in chosen]
            if lost:
                missing.append('--' + flag)
                decisions.append(f'affected: WARNING: without --{flag}, {len(lost)} steps that cover this change cannot run: ' + ' '.join(lost))
        extra = []
        if any(agent_source(path) for path in changed):
            pool = everything  # host, gui and the steps periodic moved, already planned
            selected = {step.name for step in steps}
            have = {step.name for step in steps}
            extra = [variant for variant in agent_variants(pool)
                     if variant.name[:-len(AGENT_LANE_SUFFIX)] in selected and variant.name not in have]
            steps = list(steps) + extra
            decisions.append(f'affected: agent lane adds {len(extra)} variants of steps a runtime or agent file maps to')
        decisions.append(f'affected: {len(changed)} changed files against {base} select {len(steps) - len(extra)} of {len(everything)} steps'
                         + (f', plus {len(extra)} agent variants' if extra else ''))
        print('\n'.join(decisions), file=sys.stderr if args.list else sys.stdout, flush=True)
    if args.agent_lane:
        steps, agent_notes = apply_agent_lane(steps)
        for name, reason in agent_notes:
            print(f'agent-lane: omit {name}: {reason}', file=sys.stderr)
    if args.compare_binary:
        for lane in ('native', 'agent', 'gui') if args.compare_agent else ('native', 'gui'):
            argv = [sys.executable, '-B', 'tests/command-compare.py', '--reference', str(Path(args.compare_binary).resolve()),
                    '--candidate', './zig-out/bin/xodb', '--work', '.work/command-compare-' + lane]
            if lane == 'agent':
                argv += ['--reference-agent', str(Path(args.compare_agent).resolve()), '--candidate-agent', './zig-out/bin/xodb-agent']
            if lane == 'gui':
                argv += ['--gui']  # the windowed native owner, private headless Sway
            steps += [Step('command-compare-' + lane, argv, 400 if lane == 'gui' else 270, kind='gui' if lane == 'gui' else 'live',
                           needs=('build-tests',), paths=('tests/command-compare.py',), work=('command-compare-' + lane,))]
    if args.capstone == 'vendored':
        for step in steps:
            if step.name in ('headless-app', 'build-tests', 'platform-null', 'platform-null-tests', 'platform-cocoa', 'platform-cocoa-tests', 'platform-x11'):
                step.argv.append('-Dcapstone=vendored')
    try:
        if args.only or args.start:
            steps = select(steps, args.only.split(',') if args.only else None, args.start)
    except ValueError as exc:
        parser.error(str(exc))
    if args.list:
        print(json.dumps(dict(schema=2, steps=[step.record() for step in steps]) if args.records else steps, indent=2))
        return 0
    # Gate currently certifies the x86-64 Linux build. ARM/device evidence is
    # separate; do not run x86-only probes on another architecture accidentally.
    if platform.system() != 'Linux' or platform.machine() != 'x86_64':
        parser.error('This gate currently requires x86-64 Linux; see docs/RELIABILITY.md for device checks')
    # Keep compositor Unix socket paths below sockaddr_un's 108-byte limit.
    while True:
        run = ROOT / '.work' / ('r' + secrets.token_hex(2))
        try:
            run.mkdir(parents=True)
            break
        except FileExistsError:
            continue
    logs = run / 'logs'
    logs.mkdir()
    report = dict(schema=1, tier=tier, jobs=args.jobs, affected=decisions, affected_missing_runtimes=missing, gui_build=not args.headless, capstone=args.capstone,
                  optimize=args.optimize, elisp_language=bool(args.emacs), keep_going=args.keep_going, retry_flaky=retries, only=args.only, start=args.start, perl_live_display=bool(args.perl), node_language=bool(args.node), node_frame_refusal=bool(args.node_refusal), lua_runtimes=len(args.lua), python_language=bool(args.python), ruby_language=bool(args.ruby), go_language=bool(args.go), gdscript_language=bool(args.redot), jai_pe=bool(args.wine), perl_named=bool(args.perl and args.padwalker), started=datetime.now(timezone.utc).isoformat(),
                  host=platform.uname()._asdict(), load_start=os.getloadavg(), allowed_cpus=len(os.sched_getaffinity(0)), steps=[], status='failed',
                  excluded=['ARM64/device checks', 'real GPU soak'] +
                    (['live ptrace/perf checks', 'GUI execution'] if args.tier == 'portable' else
                     ['full host integration suite', 'GUI execution'] if args.tier == 'periodic' else
                     ['full host integration suite', 'focused GUI checks'] if args.tier == 'periodic-gui' else
                     ['GUI execution'] if args.tier == 'host' else
                     ['full host integration suite'] if args.tier == 'gui' else
                     ['full host integration suite', 'GUI execution'] if args.tier == 'perf' else []) +
                    (['full overview/clipboard/Vulkan and delayed-discovery matrices (use periodic-gui)',
                      'slow, stress and second-matrix steps (PERIODIC; use periodic and periodic-gui with the same runtime flags)'] if args.tier in ('all', 'gui', 'host') else []) +
                    (['owned PE/Jai checks (use periodic --wine PATH)'] if not args.wine else []) +
                    (['Perl live display (use --perl PATH)'] if args.tier in ('gui', 'all') and not args.perl else []) +
                    (['Elisp stack checks (use --emacs PATH)'] if args.tier not in ('portable', 'perf') and not args.emacs else []) +
                    (['Ruby language checks (use --ruby PATH)'] if args.tier not in ('portable', 'perf') and not args.ruby else []) +
                    (['Go goroutine checks (use --go PATH)'] if args.tier not in ('portable', 'perf') and not args.go else []) +
                    (['GDScript stack checks (use --redot ENGINE)'] if args.tier not in ('portable', 'perf') and not args.redot else []) +
                    (['Node.js language checks (use --node PATH)'] if args.tier not in ('portable', 'perf') and not args.node else []) +
                    (['Node.js frame-proof refusal (use --node-refusal PATH)'] if args.tier in ('gui', 'all') and not args.node_refusal else []) +
                    (['Lua live checks (use --lua EXECUTABLE SOURCE LIBRARY)'] if args.tier not in ('portable', 'perf') and not args.lua else []) +
                    (['Perl named-local oracle checks (use --perl PATH --padwalker BUILT_TREE)'] if args.tier not in ('portable', 'perf') and not args.padwalker else []) +
                    (['riscv64 software-step guest (use periodic --riscv64-guest SSH AGENT FIXTURE)'] if not args.riscv64_guest else []))
    print(f'Release evidence: {run}', flush=True)
    began = time.monotonic()
    # periodic runs the live steps that host leaves out, unless it is headless.
    live = args.tier in ('host', 'all') or args.tier == 'periodic' and not args.headless
    # Gate steps must never adopt or start the user's persistent sidecar. The
    # dedicated fake and real sidecar tests replace this with private runtime,
    # cache and state directories.
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', XODB_TEST_NO_LIVE='0' if live else '1',
               XODB_GHIDRA_SIDECAR='off')
    # C live tests use presence of this opt-out, while Zig tests inspect its
    # value. Remove it completely so host/all really exercise both runtimes.
    if live:
        env.pop('XODB_TEST_NO_LIVE', None)
    for key in ('DISPLAY', 'WAYLAND_DISPLAY', 'SWAYSOCK', 'DBUS_SESSION_BUS_ADDRESS'):
        env.pop(key, None)
    try:
        report['revision'] = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
        report['working_changes'] = subprocess.check_output(['git', 'status', '--short', '--untracked-files=no'], cwd=ROOT, text=True)
        required = ['zig', 'cc', 'gcc', 'clang', 'ld.lld', 'llvm-objcopy', 'objcopy', 'strip', 'pkg-config']
        if args.tier in ('host', 'all', 'periodic', 'periodic-gui'):
            required += ['g++', 'clang++', 'gdb', 'strace']
        if args.tier in ('periodic', 'periodic-gui'):
            required += ['readelf']
        if not args.headless:
            required += ['wayland-scanner', 'glslc']
        if args.tier in ('gui', 'all', 'periodic-gui'):
            required += ['sway', 'swaymsg', 'grim']
        if args.wine:
            required.append(args.wine)
        missing = [tool for tool in required if not shutil.which(tool)]
        if args.tier in ('gui', 'all', 'periodic-gui'):
            try:
                __import__('PIL.Image')
            except ImportError:
                missing.append('Python Pillow')
            protocol = Path('/usr/share/wlr-protocols/unstable/wlr-virtual-pointer-unstable-v1.xml')
            if not protocol.is_file():
                missing.append(str(protocol))
            if len(str(run)) > 33:
                missing.append('shorter checkout path (private compositor socket paths would exceed 107 bytes)')
        if missing:
            report.update(status='blocked', reason='Missing tools: ' + ', '.join(missing))
            return 2
        capstone_prefix = ROOT / '.work' / 'capstone'
        capstone_lib = capstone_prefix / 'lib' / 'libcapstone.a'
        if args.capstone == 'vendored' and not (
                capstone_lib.is_file()
                and (capstone_prefix / 'include' / 'capstone' / 'capstone.h').is_file()):
            report.update(status='blocked', reason='Vendored Capstone prefix missing; run scripts/build-capstone')
            return 2
        if args.capstone == 'vendored':
            stamp_path = capstone_prefix / 'BUILD-STAMP'
            report['capstone_build_stamp'] = stamp_path.read_text() if stamp_path.is_file() else None
            digest = hashlib.sha256()
            with capstone_lib.open('rb') as handle:
                for chunk in iter(lambda: handle.read(1024 * 1024), b''):
                    digest.update(chunk)
            report['capstone_lib_sha256'] = digest.hexdigest()
        try:
            left, right = socket.socketpair()
            with left, right:
                left.settimeout(1)
                right.settimeout(1)
                left.sendall(b'xodb')
                if right.recv(4) != b'xodb':
                    raise RuntimeError('Local IPC probe returned incorrect bytes')
            if args.tier != 'portable':
                with socket.socket() as listener:
                    listener.bind(('127.0.0.1', 0))
                    listener.listen(1)
        except OSError as exc:
            report.update(status='blocked', reason=f'Local IPC unavailable: {exc}')
            return 2
        report['zig'] = subprocess.check_output(['zig', 'version'], text=True).strip()
        libs = ['capstone', 'libdw'] + ([] if args.headless else
                ['wayland-client', 'xkbcommon', 'vulkan', 'freetype2', 'harfbuzz'])
        deps = subprocess.run(['pkg-config', '--print-errors', '--modversion', *libs], capture_output=True, text=True)
        report['libraries'] = dict(names=libs, versions=deps.stdout, errors=deps.stderr)
        if deps.returncode:
            report.update(status='blocked', reason='Missing development libraries; see libraries.errors')
            return 2
        for name in ('perf_event_paranoid', 'perf_event_max_sample_rate', 'perf_event_mlock_kb', 'yama/ptrace_scope'):
            path = Path('/proc/sys/kernel') / name
            report[name] = path.read_text().strip() if path.exists() else None
        # Subreaper is process-local, and ensures failed tests cannot strand
        # zombies when their own finally blocks never execute.
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
            raise OSError(ctypes.get_errno(), 'PR_SET_CHILD_SUBREAPER')
        tree = run
        report['sources'] = snapshot(tree)
        if args.capstone == 'vendored':
            # The snapshot keeps gitignored trees out. The vendored build looks
            # for this prefix relative to the snapshot root.
            shutil.copytree(capstone_prefix, tree / '.work' / 'capstone')
        (tree / '.work/tmp').mkdir(parents=True)
        env['TMPDIR'] = str(tree / '.work/tmp')
        if args.tier != 'portable':
            preflight = [Step('probe-build', ['cc', '-Wall', '-Wextra', '-Werror',
                         'tests/release-probe.c', '-o', '.work/release-probe'], 30, 'build'),
                         Step('capabilities', ['.work/release-probe'], 10, 'build', ['probe-build'])]
        else:
            preflight = []
        # SIGINT too: a launcher's `cmd &` leaves it ignored, the steps would
        # inherit that, and a test's SIGINT to its own child would do nothing.
        for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(number, signal.default_int_handler)  # stop the steps, as for an interrupt
        code = run_steps([*preflight, *steps], tree, env, logs, report, args.keep_going, retries, args.jobs)
        if code:
            return code
        if args.tier == 'perf':
            report.update(performance_summary(tree))
        else:
            report['status'] = 'passed'
        return 0
    except KeyboardInterrupt:
        report.update(status='interrupted', reason='Interrupted by user')
        return 130
    except Exception as exc:
        report.update(status='failed', reason=str(exc))
        return 1
    finally:
        report['load_end'] = os.getloadavg()
        report['finished'] = datetime.now(timezone.utc).isoformat()
        report['wall_seconds'] = round(time.monotonic() - began, 3)
        timed = sorted((step for step in report['steps'] if 'seconds' in step), key=lambda step: -step['seconds'])
        report['step_seconds'] = round(sum(step['seconds'] for step in timed), 3)
        (run / 'results.json').write_text(json.dumps(report, indent=2) + '\n')
        summary = report.get('summary')
        for failure in report.get('failures', []):
            print(f"{'failed':16} {failure['name']} ({failure['status']}): {failure['log']}", flush=True)
        for step in report.get('skipped', []):
            print(f"{'not run':16} {step['name']} (needs {', '.join(step['needs'])})", flush=True)
        if summary:
            print(f"Summary: {summary['passed']} passed, {summary['flaky']} flaky, {summary['failed']} failed, {summary['not_run']} not run"
                  + (': flaky ' + ', '.join(report['flaky']) if report['flaky'] else ''), flush=True)
        if args.slowest:
            print(f"Slowest: " + ', '.join(f"{step['name']} {step['seconds']:.1f}s" for step in timed[:args.slowest])
                  + f" (steps {report['step_seconds']:.0f}s, wall {report['wall_seconds']:.0f}s, jobs {args.jobs})", flush=True)
        print(f"{report['status'].upper()}: {report.get('reason', tier + ' checks completed')}"
              + (f"; NOT COVERED: steps for {' '.join(missing)} (not passed)" if missing else ''), flush=True)
        print(f'Results: {run / "results.json"}', flush=True)


if __name__ == '__main__':
    sys.exit(main())
