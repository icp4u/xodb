    'gui-files*', 'gui-fdtreemap', 'gui-overview-live', 'gui-live-display', 'gui-frames', 'gui-invocations',
    'gui-repeated-break', 'gui-remote-caller',
    'elisp-bindings-gui-*', 'go-native-values-gui', 'ruby-previews-gui', 'ruby-path-watches-gui', 'ruby-expression-gui',
    'javascript-watches-gui', 'javascript-context-gui', 'javascript-advisory-gui', 'javascript-frame-refusal-gui',
    'python-named-gui', 'python-watch-gui', 'python-path-watch-gui', 'perl-named-gui', 'perl-watch-gui', 'perl-path-watch-gui',
    'lua-gui', 'lua-path-watch-gui-*', 'lua-watch-reuse-gui-*', 'lua-named-gui-1', 'lua-watch-gui-1',
)


def periodic(name):
    return any(fnmatch.fnmatchcase(name, pattern) for pattern in PERIODIC)


def covered(name, argv):
    paths = [arg for arg in argv if isinstance(arg, str) and arg.startswith(('tests/', 'scripts/')) and arg != 'scripts/build']
    for sources, names in () if periodic(name) else COVERS:
        if any(fnmatch.fnmatchcase(name, pattern) for pattern in names):
            paths += sources
    return tuple(dict.fromkeys(paths))


class Step(tuple):
    """One planned command. It is still the (name, argv, timeout) triple.

    kind:   build, unit, live, gui or periodic.
    needs:  names of the steps that must pass first.
    paths:  source globs this step covers (see COVERS).
    serial: a gui step that must run alone under --jobs.
    work:   entries this step creates directly in .work under fixed names.
    """
    def __new__(cls, name, argv, timeout, kind='unit', needs=(), paths=(), serial=False, work=()):
        self = super().__new__(cls, (name, argv, timeout))
        self.name, self.argv, self.timeout = name, argv, timeout
        self.kind, self.needs, self.paths, self.serial, self.work = kind, tuple(needs), tuple(paths), serial, tuple(work)
        return self

    def record(self):
        return dict(name=self.name, argv=self.argv, timeout=self.timeout, kind=self.kind, needs=list(self.needs),
                    paths=list(self.paths), serial=self.serial, work=list(self.work))


class Steps(list):
    """plan()'s list. append() takes (name, argv, timeout[, fields]) and fills
    in the section's kind, the build prerequisite and the covered paths."""
    kind = 'unit'

    def append(self, step):
        if isinstance(step, Step):
            return super().append(step)
        name, argv, timeout = step[:3]
        fields = dict(step[3]) if len(step) > 3 else {}
        fields.setdefault('kind', self.kind)
        needs = [*fields.get('needs', ())]
        if fields['kind'] != 'build' and 'build-tests' not in needs:
            needs.insert(0, 'build-tests')
        fields['needs'] = needs
        fields.setdefault('paths', covered(name, argv))
        fields.setdefault('serial', fields['kind'] == 'gui' and name in SERIAL)
        named = [arg.split('/')[1] for arg in argv if isinstance(arg, str) and arg.startswith('.work/')]
        fields['work'] = tuple(dict.fromkeys([*fields.get('work', ()), *named]))
        super().append(Step(name, argv, timeout, **fields))

    def __iadd__(self, more):
        for step in more:
            self.append(step)
        return self


# The local C agent. One switch, XODB_TEST_RUNTIME_AGENT, makes tests/client.py
# and the GUI input helper pass --runtime-agent. Steps that cannot use that
# path say why in AGENT_INELIGIBLE.
AGENT_BIN = './zig-out/bin/xodb-agent'
AGENT_LANE_SUFFIX = '-agent-lane'
