    steps.append(('client-control', [sys.executable, '-B', 'tests/client-control.py'], 30))
    if tier != 'perf':
        steps.append(('pe-image', [sys.executable, '-B', 'tests/pe-image.py',
                      '--work', '.work/pe-image'], 30))
        steps.append(('pdb-image', [sys.executable, '-B', 'tests/pdb-image.py',
