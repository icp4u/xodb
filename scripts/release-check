# Cheap steps that cover every source file without counting as its coverage in
# `affected`: a file only they cover still selects the full gui tier.
ALWAYS = ('deps',)

# GUI steps that must run alone under --jobs: they assert frame time, CPU or
# RSS, inject compositor/Vulkan timeouts, rank processes by CPU, make many
# OCR passes with bounded waits, or read a pixel from the first frame.
