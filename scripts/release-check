    if tier == 'perf':
        steps.kind = 'periodic'
        steps.append(('observer-measurements', [sys.executable, '-B', 'tests/perf-observers.py',
                      '--work', '.work/perf-observers'], 180))
        steps.append(('remote-stop-measurements', [sys.executable, '-B', 'tests/remote-stops.py', '--perf',
                      '--work', '.work/perf-remote-stops'], 180))
