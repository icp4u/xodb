_CLIENT_CACHE = None


def _test_script(step):
    for arg in step.argv:
        if isinstance(arg, str) and arg.startswith('tests/') and arg.endswith('.py'):
            return arg
    return None


def _launches_debugger(body):
    """The file starts the debugger binary. Naming that path is not enough:
    a self-test can quote a step argv, and a fixture can use the path as a filename."""
    import re
    token = r'zig-out/bin/xodb(?![\w.-])'
    if not re.search(token, body):
        return False
    nested = r'(?:[^]()\n]|\([^)]*\)){0,240}'
    if re.search(r'\b(?:Popen|run|check_call|check_output)\s*\(\s*\[' + nested + token, body):
        return True
    if re.search(r'\b(?:binary|xodb|server)\b[^\n]{0,120}' + token, body):
        return True
    if re.search(r'''root\s*/\s*['\"]''' + token, body):
        return True
    if re.search(r'''XODB_BIN['\"]\s*,\s*['\"][^'\"]*''' + token, body):
        return True
    return False


def _client_and_direct():
    """Test scripts that construct tests/client.py Client, and scripts that
    start the debugger without that client. Helpers count when imported."""
    global _CLIENT_CACHE
    if _CLIENT_CACHE is not None:
        return _CLIENT_CACHE
    import re
    root = ROOT / 'tests'
    files = [path for path in root.rglob('*.py')]
    text = {path: path.read_text(errors='replace') for path in files}

    def uses(path, seen):
        if path in seen or path not in text:
            return False
        seen.add(path)
        body = text[path]
        if 'Client(' in body and re.search(r'(from client import|import client\b|client\.Client\b)', body):
            return True
        for mod in re.findall(r'^\s*(?:from|import)\s+([\w.]+)', body, re.M):
            mod = mod.split()[0].split('.')
            if mod[0] == 'helpers' and len(mod) > 1:
                helper = root / 'helpers' / (mod[1] + '.py')
            elif mod[0] == 'client':
                return 'Client(' in body
            else:
                helper = root / (mod[0] + '.py')
            if uses(helper, seen):
                return True
        return False

    users, direct = set(), set()
    for path in files:
        rel = str(path.relative_to(ROOT))
        if uses(path, set()):
            users.add(rel)
        elif _launches_debugger(text[path]):
            direct.add(rel)
    _CLIENT_CACHE = (users, direct)
    return _CLIENT_CACHE


def _argv_has_agent(argv):
    for arg in argv:
        if not isinstance(arg, str):
            continue
        if arg in ('--agent', '--runtime-agent') or arg.startswith('XODB_RUNTIME_AGENT=') or arg.startswith('XODB_TEST_RUNTIME_AGENT='):
            return True
    return False


def _normalized_argv(argv):
    """Command identity ignoring the agent switch and the work directory."""
    out, skip = [], False
    for arg in argv:
        if skip:
            skip = False
            continue
        if not isinstance(arg, str) or arg == 'env' or arg.startswith('XODB_RUNTIME_AGENT=') or arg.startswith('XODB_TEST_RUNTIME_AGENT='):
            continue
        if arg in ('--agent', '--runtime-agent', '--work'):
            skip = True
            continue
        if arg.startswith('.work/'):
            continue
        out.append(arg)
    return tuple(out)


# tests/release-runner.py quotes the gate flag --headless. It does not start xodb.
PLAIN_LAUNCH_FLAG_EXEMPT = 'tests/release-runner.py'


def _script_names_launch_flag(script):
    """True when the script text contains --headless or --listen.

    A step that stays plain while its script names either flag is a
    classifier miss. The check is the script body, not a launch.
    """
    try:
        body = (ROOT / script).read_text(errors='replace')
    except OSError:
        return False
    return '--headless' in body or '--listen' in body


def agent_fate(step):
    """'twin', 'eligible', 'ineligible', 'invalid' or 'plain'.

    Ineligible returns a reason. Invalid is a plain script that names
    --headless or --listen; apply_agent_lane refuses it.
    """
    # An argv that already names the agent is a twin, including the GUI owner
    # matrix. Classifying every gui step first would drop that matrix.
    if _argv_has_agent(step.argv) or step.name in AGENT_BOTH_PATHS:
        return 'twin', ''
    if step.kind == 'gui' or step.name.startswith('gui-'):
        return 'ineligible', 'GUI compositor path; the headless step covers the target transport'
    if step.name in AGENT_INELIGIBLE:
        return 'ineligible', AGENT_INELIGIBLE[step.name]
    script = _test_script(step)
    if script is None or step.kind == 'build':
        return 'plain', ''
    users, direct = _client_and_direct()
    if script in users:
        return 'eligible', ''
    if script in direct:
        if script in AGENT_ROUTABLE:
            return 'eligible', ''
        return 'ineligible', AGENT_DIRECT.get(script, 'starts xodb without tests/client.py, so the lane switch cannot reach it')
    if script != PLAIN_LAUNCH_FLAG_EXEMPT and _script_names_launch_flag(script):
        return 'invalid', 'a plain step whose script contains --headless or --listen'
    return 'plain', ''


def _agent_variant(step):
    argv = ['env', 'XODB_TEST_RUNTIME_AGENT=' + AGENT_BIN]
    skip = False
    work = []
    for arg in step.argv:
        if skip:
            skip = False
            if isinstance(arg, str) and arg.startswith('.work/'):
                arg = arg + AGENT_LANE_SUFFIX
                work.append(arg[len('.work/'):])
            argv.append(arg)
            continue
        argv.append(arg)
        if arg == '--work':
            skip = True
    for entry in step.work:
        suffixed = entry if str(entry).endswith(AGENT_LANE_SUFFIX) else entry + AGENT_LANE_SUFFIX
        if suffixed not in work:
            work.append(suffixed)
    return Step(step.name + AGENT_LANE_SUFFIX, argv, step.timeout, kind=step.kind, needs=step.needs,
                paths=step.paths, serial=step.serial, work=tuple(work))


def _twins_cover(steps):
    return {_normalized_argv(step.argv) for step in steps if agent_fate(step)[0] == 'twin'}


def agent_variants(steps):
    """Agent form of each eligible step that no hand-written twin already covers."""
    covered = _twins_cover(steps)
    return [_agent_variant(step) for step in steps
            if agent_fate(step)[0] == 'eligible' and _normalized_argv(step.argv) not in covered]


def apply_agent_lane(steps):
    """Run eligible steps through the C agent. Keep twins and steps with no
    target. Omit ineligible steps and return (name, reason) for each.
    A variant that is already scheduled is not emitted twice. An invalid
    plain step, one whose script names --headless or --listen, raises."""
    covered = _twins_cover(steps)
    scheduled = {step.name for step in steps}
    out, notes = [], []
    for step in steps:
        fate, reason = agent_fate(step)
        if fate == 'eligible':
            variant = _agent_variant(step)
            if _normalized_argv(step.argv) in covered:
                notes.append((step.name, 'an existing agent twin runs this command'))
                continue
            if variant.name in scheduled:
                notes.append((step.name, 'the agent lane already schedules this step'))
                continue
            out.append(variant)
        elif fate == 'ineligible':
            notes.append((step.name, reason))
        elif fate == 'invalid':
            raise ValueError(step.name + ': ' + reason)
        else:
            out.append(step)
    return out, notes


def agent_source(path):
    """A change here selects the agent variant of every step it already maps to."""
    return path.startswith(('src/runtime/', 'src/remote/', 'src/model/remote_')) or path in (
        'src/mcp/remote.zig', 'src/target/runtime.zig', 'src/target/linux.zig', 'tests/client.py',
        'tests/shared-sessions.py')


def plan(tier, headless=False, optimize='ReleaseSafe', uprobes=False, perl=None, node=None, node_include='/usr/include/node', lua=(), python=None, padwalker=None, ruby=None, node_refusal=None, go=None, wine=None, emacs=None, moved=False, redot=None, macos_ssh=None, arm64_sidecar=None, macos=None, riscv64_guest=None):
    # moved: return the PERIODIC steps of this tier's host and gui lanes instead of the others.
    runtimes = (headless, optimize, uprobes, perl, node, node_include, lua, python, padwalker, ruby, node_refusal, go, wine, emacs)
    live = tier in ('host', 'all')
    language_args = (['--python', python] if python else []) + (['--perl', perl] if perl else []) + (['--node', node] if node else [])
    gui_language_args = [*language_args]
    for executable, _, _ in lua:
        language_args += ['--lua', executable]
    if lua:
        gui_language_args += ['--lua', lua[0][0]]
    steps = Steps()
    if not headless:
        steps.append(('headless-app', ['scripts/build', 'app', '-Dgui=false', '-Doptimize=' + optimize,
                      '-p', '.work/headless-app'], 600, dict(kind='build')))
    steps.append(('build-tests', ['scripts/build', 'test', '--summary', 'all',
                  '-Dgui=' + str(not headless).lower(), '-Doptimize=' + optimize], 600,
                  dict(kind='build', needs=() if headless else ('headless-app',))))
    if macos and not headless and tier in ('gui', 'all', 'periodic'):
        steps.append(('macos-native', [sys.executable, '-B', 'tests/macos-native.py', '--ssh', macos], 420))
        steps.append(('macos-bootstrap', [sys.executable, '-B', 'tests/macos-native.py', '--ssh', macos, '--bootstrap'], 420))
        steps.append(('macos-local', [sys.executable, '-B', 'tests/macos-native.py', '--ssh', macos, '--local'], 420))
        if tier == 'periodic':
            steps.append(('macos-native-stress', [sys.executable, '-B', 'tests/macos-native.py', '--ssh', macos, '--stress'], 1000))
    if not headless and tier in ('gui', 'all'):
        # The interface with no window system behind src/platform/window.zig: nothing else may name one.
        steps.append(('platform-null', ['scripts/build', 'app', '-Dplatform=null', '-Doptimize=' + optimize,
                      '-p', '.work/platform-null'], 600, dict(kind='build')))
        steps.append(('platform-cocoa', ['scripts/build', 'app', '-Dplatform=cocoa', '-Doptimize=' + optimize,
                      '-p', '.work/platform-cocoa'], 600, dict(kind='build')))
        steps.append(('platform-x11', ['scripts/build', 'app', '-Dplatform=x11', '-Doptimize=' + optimize,
                      '-p', '.work/platform-x11'], 600, dict(kind='build')))
        steps.append(('platform-cocoa-tests', ['scripts/build', 'test-cocoa', '-Dplatform=cocoa', '-Doptimize=' + optimize,
                      '-p', '.work/platform-cocoa'], 900, dict(kind='build')))
    if not headless and tier == 'periodic':
        steps.append(('platform-null-tests', ['scripts/build', 'test', '-Dplatform=null', '-Doptimize=' + optimize,
                      '-p', '.work/platform-null'], 900, dict(kind='build')))
        steps.append(('platform-cocoa-tests', ['scripts/build', 'test-cocoa', '-Dplatform=cocoa', '-Doptimize=' + optimize,
                      '-p', '.work/platform-cocoa'], 900, dict(kind='build')))
    if tier == 'periodic':
        steps.append(('catalog-build', [sys.executable, '-B', 'tests/catalog-build.py', '--work', '.work/catalog-build'], 600))
    if tier == 'periodic' and go:
        steps.append(('go-maps-interleaved', [sys.executable, '-B', 'tests/go-maps.py', '--go', go, '--experiment', 'nomapsplitgroup', '--strace', '--work', '.work/go-maps-interleaved'], 180))
    steps.append(('remote-retry', ['zig', 'test', 'src/model/remote_retry.zig', '-OReleaseSafe'], 30))
    steps.append(('command-decode', [sys.executable, '-B', 'tests/command-decode.py'], 5))
