    steps.append(('scene3d-math', ['zig', 'test', 'src/render/scene3d/math.zig', '-OReleaseSafe'], 30))
    # Burrito mode: ath9k parser, detector on synthetic spectra, nl80211 codec, card policy (no hardware).
    steps.append(('radio-detector', ['zig', 'test', 'src/radio/radio.zig', '-OReleaseSafe'], 120))
    steps.append(('go-type-index', [sys.executable, '-B', 'tests/go-type-index.py', '--work', '.work/go-type-index'], 60))
    steps.append(('go-maps-component', [sys.executable, '-B', 'tests/go-maps-component.py', '--work', '.work/go-maps-component'], 60))
