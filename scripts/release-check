# GUI steps that are never retried: they inject faults or race the renderer,
# so one failure in several runs is the defect they exist to catch.
NO_RETRY = {'scene3d-faults', 'vulkan-faults', 'vulkan-enumeration', 'vulkan-device', 'vulkan-scale-recovery', 'hidden-window', 'acquire-timeout', 'fence-timeout', 'wayland-read-race'}

